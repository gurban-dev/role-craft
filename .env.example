# =============================================================================
# Job Application Automation — environment template
# Copy to `.env` and fill in secrets:  cp .env.example .env
# Never commit real credentials.
# =============================================================================

# --- App ---
APP_ENV=development
DEBUG=false
APP_NAME=Job Application Automation
API_PREFIX=/api

# --- Postgres (used by docker-compose; local defaults match) ---
POSTGRES_USER=jaa
POSTGRES_PASSWORD=jaa
POSTGRES_DB=jaa

# Async SQLAlchemy URL (API). Sync URL used by Alembic/Celery.
# Docker Compose overrides these for container networking.
DATABASE_URL=postgresql+asyncpg://jaa:jaa@localhost:5432/jaa
DATABASE_URL_SYNC=postgresql+psycopg://jaa:jaa@localhost:5432/jaa

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth / cookies (REQUIRED: replace before any real use) ---
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_SECRET=change-me-jwt-secret-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_NAME=jaa_session
CSRF_COOKIE_NAME=jaa_csrf
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional Fernet key for credentials at rest; derived from SECRET_KEY if unset.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# --- CORS / frontend ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_APP_URL=http://localhost:3000

# --- Google OAuth (optional; enables "Continue with Google") ---
# Create a Web application OAuth client in Google Cloud Console.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- LLM (OpenAI required for AI features) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# --- Quality / workflow controls ---
DAILY_APPLICATION_LIMIT=10
MIN_MATCH_SCORE=0.65
MIN_RESUME_SCORE=0.70
MIN_OUTREACH_EVIDENCE_CONFIDENCE=0.60
MIN_CONTACT_CONFIDENCE=0.55
MIN_ANSWER_CONFIDENCE=0.70
AUTO_SUBMIT_ENABLED=false
OUTREACH_ENABLED=true
BROWSER_AUTOMATION_ENABLED=true
LINKEDIN_EASY_APPLY_FALLBACK=false

# --- Scoring weights (should sum ~1.0) ---
WEIGHT_TECHNICAL=0.30
WEIGHT_EXPERIENCE=0.20
WEIGHT_SENIORITY=0.15
WEIGHT_LOCATION=0.10
WEIGHT_DOMAIN=0.10
WEIGHT_SALARY=0.05
WEIGHT_PREFERENCE=0.10

# --- Rate limits ---
RATE_LIMIT_JOB_DISCOVERY_PER_HOUR=30
RATE_LIMIT_LLM_PER_HOUR=200
RATE_LIMIT_BROWSER_PER_HOUR=20
RATE_LIMIT_RESEARCH_PER_HOUR=40
BROWSER_MAX_CONCURRENCY=1

# --- Storage / retention (days; 0 = keep forever) ---
STORAGE_PATH=./storage
RETENTION_DAYS_APPLICATIONS=365
RETENTION_DAYS_AUTOMATION_RUNS=90
RETENTION_DAYS_AI_USAGE=180
